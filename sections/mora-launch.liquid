<section class="mora-launch">
  <div class="mora-launch__visual">
    {% if section.settings.image != blank %}
      {{ section.settings.image | image_url: width: 2400 | image_tag: widths: '600, 1000, 1600, 2400', sizes: '100vw', loading: 'eager', class: 'mora-launch__image' }}
    {% endif %}
    <div class="mora-launch__content">
      <p class="mora-launch__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      <h1>{{ section.settings.heading | escape }}</h1>
      <p>{{ section.settings.description | escape }}</p>
      {% if section.settings.collection != blank %}
        <a class="mora-launch__button" href="{{ section.settings.collection.url }}">{{ section.settings.button_label | escape }}</a>
      {% endif %}
    </div>
  </div>
  <div class="mora-launch__collective">
    <div><p class="mora-launch__eyebrow">COLLECTIVE BY MORA</p><h2>{{ section.settings.membership_heading | escape }}</h2><p>{{ section.settings.membership_text | escape }}</p></div>
    <a class="mora-launch__button mora-launch__button--dark" href="{{ routes.account_url }}">MY ACCOUNT</a>
  </div>
</section>
{% style %}
.mora-launch { background: #f4f1ea; color: #191919; }
.mora-launch__visual { min-height: 72vh; position: relative; display: flex; align-items: flex-end; background: #282823; color: #fff; }
.mora-launch__visual:after { content: ''; position: absolute; inset: 0; background: linear-gradient(transparent,rgba(0,0,0,.6)); pointer-events: none; }
.mora-launch__image { position: absolute; width: 100%; height: 100%; object-fit: cover; }
.mora-launch__content { position: relative; z-index: 1; padding: clamp(28px,6vw,90px); max-width: 850px; }
.mora-launch__eyebrow { letter-spacing: .2em; font-size: 12px; }
.mora-launch h1 { color: inherit; font-size: clamp(48px,9vw,120px); line-height: .95; letter-spacing: -.05em; margin: 20px 0; }
.mora-launch h2 { color: inherit; font-size: clamp(28px,4vw,48px); margin: 12px 0; }
.mora-launch__button { display: inline-block; border: 1px solid currentColor; color: inherit; padding: 14px 24px; text-decoration: none; font-size: 13px; letter-spacing: .12em; margin-top: 16px; }
.mora-launch__button:hover { background: #fff; color: #191919; }
.mora-launch__button:focus-visible { outline: 3px solid currentColor; outline-offset: 5px; }
.mora-launch__collective { padding: clamp(28px,6vw,80px); display: flex; gap: 24px; justify-content: space-between; align-items: center; }
.mora-launch__collective p { max-width: 600px; }
.mora-launch__button--dark:hover { background: #191919; color: #fff; }
@media(max-width:749px) { .mora-launch__collective { flex-direction: column; align-items: flex-start; } .mora-launch__visual { min-height: 60vh; } }
{% endstyle %}
{% schema %}
{
  "name": "MORA launch",
  "settings": [
    {"type":"image_picker","id":"image","label":"Campaign photograph"},
    {"type":"text","id":"eyebrow","label":"Launch label","default":"MORA — FIRST COLLECTION"},
    {"type":"text","id":"heading","label":"Heading","default":"A NEW CHAPTER."},
    {"type":"text","id":"description","label":"Description","default":"Discover the first collection by MORA."},
    {"type":"collection","id":"collection","label":"Launch collection"},
    {"type":"text","id":"button_label","label":"Button label","default":"EXPLORE THE COLLECTION"},
    {"type":"text","id":"membership_heading","label":"Collective heading","default":"Be part of the collective."},
    {"type":"text","id":"membership_text","label":"Collective description","default":"Create your account to keep your orders and your next chapter with MORA in one place."}
  ],
  "presets": [{"name":"MORA launch"}]
}
{% endschema %}
