<section class="page-width mora-membership">
  <p class="mora-membership__eyebrow">COLLECTIVE BY MORA</p>
  <h1>THE MORA FAMILY</h1>
  <p>A place for your next chapter with MORA.</p>
  {% if customer %}
    <div class="mora-membership__welcome">
      <h2>Welcome{% if customer.first_name != blank %}, {{ customer.first_name | escape }}{% endif %}.</h2>
      {% if customer.tags contains 'MORA_VIP' %}
        <p>Your current level: <strong>VIP</strong></p>
      {% elsif customer.tags contains 'MORA_INSIDER' %}
        <p>Your current level: <strong>INSIDER</strong></p>
      {% else %}
        <p>Your current level: <strong>MEMBER</strong></p>
      {% endif %}
      <p>Keep your orders and account information together.</p>
      <a class="button" href="{{ routes.account_url }}">MY ACCOUNT</a>
    </div>
  {% elsif shop.customer_accounts_enabled %}
    <div class="mora-membership__welcome">
      <h2>Join the family.</h2>
      <p>Create your account or sign in to view your orders.</p>
      <a class="button" href="{{ routes.account_url }}">CREATE ACCOUNT / SIGN IN</a>
    </div>
  {% else %}
    <p>Subscribe below for news from MORA.</p>
  {% endif %}
  {% if section.settings.show_program %}
    <div class="mora-membership__levels">
      <article><h2>MEMBER</h2><p>{{ section.settings.member_text | escape }}</p></article>
      <article><h2>INSIDER</h2><p>{{ section.settings.insider_text | escape }}</p></article>
      <article><h2>VIP</h2><p>{{ section.settings.vip_text | escape }}</p></article>
    </div>
    <p>{{ section.settings.program_note | escape }}</p>
  {% endif %}
  <p class="mora-membership__note">Your account and your email subscription are separate. Subscribe to receive collection announcements and offers.</p>
</section>
{% style %}
.mora-membership{padding-top:64px;padding-bottom:64px;text-align:center;max-width:1100px}
.mora-membership__eyebrow{font-size:11px;letter-spacing:.2em}
.mora-membership h1{font-size:clamp(32px,5vw,64px)}
.mora-membership__welcome{background:#eeece4;color:#24261f;padding:32px;margin:32px auto;max-width:640px}
.mora-membership__welcome h2{color:inherit}
.mora-membership__levels{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;margin:40px 0}
.mora-membership__levels article{border:1px solid #bbb;padding:24px}
.mora-membership__note{font-size:13px;max-width:600px;margin:24px auto}
@media(max-width:749px){.mora-membership__levels{grid-template-columns:1fr}}
{% endstyle %}
{% schema %}
{"name":"MORA family page","settings":[
{"type":"checkbox","id":"show_program","label":"Show loyalty program (enable after configuring and testing rules)","default":false},
{"type":"text","id":"member_text","label":"Member description","default":"Your MORA account and order history."},
{"type":"text","id":"insider_text","label":"Insider description","default":"A level for returning MORA customers."},
{"type":"text","id":"vip_text","label":"VIP description","default":"A level for our most loyal MORA customers."},
{"type":"text","id":"program_note","label":"Program terms summary","default":"Launch benefits and eligibility will be announced with each collection."}
],"presets":[{"name":"MORA family page"}]}
{% endschema %}