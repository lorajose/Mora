{% stylesheet %}
.mora-photo-catalog{background:#fff;padding:40px 24px 80px}.mora-photo-catalog__grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:72px 36px;max-width:2000px;margin:0 auto}.mora-photo-catalog__item{display:block;aspect-ratio:1;background:#fff}.mora-photo-catalog__item img{display:block;width:100%;height:100%;object-fit:contain;mix-blend-mode:multiply}.mora-photo-catalog__item:focus-visible{outline:2px solid #111;outline-offset:5px}@media(max-width:1199px){.mora-photo-catalog__grid{grid-template-columns:repeat(4,minmax(0,1fr));gap:48px 24px}}@media(max-width:749px){.mora-photo-catalog{padding:24px 16px 56px}.mora-photo-catalog__grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:36px 16px}}

.mora-catalog-slider{margin-top:100px}.mora-catalog-slider__viewport{overflow-x:auto;scrollbar-width:none;cursor:grab;touch-action:pan-y;user-select:none}.mora-catalog-slider__viewport::-webkit-scrollbar{display:none}.mora-catalog-slider__viewport.is-dragging{cursor:grabbing}.mora-catalog-slider__track{display:flex;width:max-content}.mora-catalog-slider__group{display:flex;align-items:center;gap:48px;padding-right:48px}.mora-catalog-slider__group .mora-photo-catalog__item{width:clamp(88px,11vw,180px);flex:none}.mora-catalog-slider img{-webkit-user-drag:none;pointer-events:none}.mora-catalog-slider__viewport:focus-visible{outline:2px solid #111;outline-offset:5px}@media(max-width:749px){.mora-catalog-slider{margin-top:64px}.mora-catalog-slider__group{gap:24px;padding-right:24px}}


.mora-photo-catalog__item{aspect-ratio:auto;color:#171914;text-decoration:none}
.mora-catalog-product__photos{position:relative;aspect-ratio:1}
.mora-catalog-product__photos img{position:absolute;inset:0;transition:opacity .3s ease}
.mora-catalog-product__back{opacity:0}
@media(hover:hover){.mora-photo-catalog__item:has(.mora-catalog-product__back):hover .mora-catalog-product__front{opacity:0}.mora-photo-catalog__item:hover .mora-catalog-product__back{opacity:1}}
.mora-photo-catalog__item:has(.mora-catalog-product__back):focus-visible .mora-catalog-product__front{opacity:0}.mora-photo-catalog__item:focus-visible .mora-catalog-product__back{opacity:1}
.mora-catalog-product__title{display:block;font-size:12px;text-align:center;letter-spacing:.06em;padding:18px 5px}
.mora-photo-catalog:has([data-catalog-detail]:not([hidden]))>.mora-photo-catalog__grid,.mora-photo-catalog:has([data-catalog-detail]:not([hidden]))>.mora-catalog-slider{display:none}
.mora-catalog-detail__back{display:inline-block;margin:0 0 30px;color:inherit;font-size:13px}
.mora-catalog-detail__layout{display:grid;grid-template-columns:minmax(0,1.5fr) minmax(280px,1fr);gap:6vw;max-width:1500px;margin:auto;align-items:start}
.mora-catalog-detail__hero{display:block;width:100%;height:65svh;object-fit:contain}
.mora-catalog-detail__thumbs{display:flex;justify-content:center;gap:12px;margin:20px 0}
.mora-catalog-detail__thumbs button{border:1px solid #ddd;background:#fff;padding:4px;cursor:pointer}.mora-catalog-detail__thumbs button[aria-pressed=true]{border:2px solid #222}
.mora-catalog-detail__thumbs img{width:75px;height:85px;object-fit:contain;display:block}
.mora-catalog-detail__info{padding-top:40px;position:sticky;top:30px}.mora-catalog-detail__info h1{font-size:clamp(28px,4vw,48px);line-height:1.2}
.mora-catalog-detail__info>p:first-child{font-size:11px;letter-spacing:.16em}.mora-catalog-detail__info p{line-height:1.7}.mora-catalog-detail__info details{border-top:1px solid #ddd;padding:20px 0}.mora-catalog-detail__info summary{cursor:pointer}
.mora-catalog-detail__all{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:40px}.mora-catalog-detail__all img{width:100%;height:auto;display:block}
@media(max-width:749px){.mora-catalog-detail__layout{grid-template-columns:1fr;gap:20px}.mora-catalog-detail__hero{height:48svh}.mora-catalog-detail__info{position:static;padding-top:0}.mora-catalog-product__title{font-size:10px}}
@media(prefers-reduced-motion:reduce){.mora-catalog-product__photos img{transition:none}}

{% endstylesheet %}
{% javascript %}

(() => {
document.querySelectorAll('.mora-photo-catalog').forEach(root=>{
const id=new URLSearchParams(location.search).get('item');
if(!id)return;
const items=JSON.parse(root.querySelector('[data-catalog-products]').textContent);
const item=items.find(p=>p.id===id);if(!item)return;
const mount=root.querySelector('[data-catalog-detail]');mount.hidden=false;
root.querySelector('.mora-catalog-slider').hidden=true;
root.querySelector('.mora-photo-catalog__grid').hidden=true;
root.querySelector('h1.visually-hidden')?.remove();
document.title=item.title+' | Collective by MORA';
const el=(tag,cls,text)=>{const n=document.createElement(tag);if(cls)n.className=cls;if(text)n.textContent=text;return n;};
const back=el('a','mora-catalog-detail__back','← Back to Catalog');back.href=location.pathname;
const layout=el('div','mora-catalog-detail__layout'),gallery=el('div'),info=el('div','mora-catalog-detail__info');
const hero=el('img','mora-catalog-detail__hero');hero.width=1200;hero.height=1200;hero.src=item.images[0].src;hero.alt=item.images[0].alt;
const thumbs=el('div','mora-catalog-detail__thumbs');
item.images.forEach((im,i)=>{const button=el('button');button.type='button';button.setAttribute('aria-label',im.alt);button.setAttribute('aria-pressed',String(i===0));const image=el('img');image.src=im.src;image.alt='';image.width=75;image.height=85;button.append(image);button.addEventListener('click',()=>{hero.src=im.src;hero.alt=im.alt;thumbs.querySelectorAll('button').forEach(b=>b.setAttribute('aria-pressed',String(b===button)));});thumbs.append(button);});
gallery.append(hero,thumbs);
if(item.images.length>1){const all=el('div','mora-catalog-detail__all');item.images.forEach(im=>{const image=el('img');image.src=im.src;image.alt=im.alt;image.loading='lazy';image.width=1200;image.height=1200;all.append(image);});gallery.append(all);}
info.append(el('p','','COLLECTIVE BY MORA'),el('h1','',item.title),el('p','','Collection preview'));
const details=el('details');details.open=true;details.append(el('summary','','Product details'),el('p','','Price, sizes, materials and release date will be announced.'));
info.append(details);
const follow=el('a','','Follow @bymora.ny for updates ↗');follow.href='https://www.instagram.com/bymora.ny/';follow.rel='noopener noreferrer';follow.target='_blank';info.append(follow);
layout.append(gallery,info);mount.append(back,layout);
});
})();


(() => {
  const setup = root => {
    if(root.hidden)return;
    if(root.dataset.dragReady) return;
    root.dataset.dragReady='true';
    const viewport=root.querySelector('.mora-catalog-slider__viewport');
    const group=root.querySelector('.mora-catalog-slider__group');
    const reduced=matchMedia('(prefers-reduced-motion: reduce)');
    let pointer=null,lastX=0,startX=0,moved=false,resumeAt=0,lastTime=0,frame,position=0,loopWidth=0;
    const track=root.querySelector('.mora-catalog-slider__track');
    const cover=()=>{
      loopWidth=group.getBoundingClientRect().width;
      if(loopWidth<=0)return;
      while(track.scrollWidth<viewport.clientWidth+loopWidth*2){
        const copy=group.cloneNode(true);copy.setAttribute('aria-hidden','true');
        copy.querySelectorAll('a').forEach(a=>a.tabIndex=-1);
        copy.querySelectorAll('img').forEach(img=>img.alt='');
        track.append(copy);
      }
      position=viewport.scrollLeft||loopWidth;
      viewport.scrollLeft=position;
    };
    const wrap=()=>{if(loopWidth>0){position=((viewport.scrollLeft%loopWidth)+loopWidth)%loopWidth+loopWidth;viewport.scrollLeft=position;}};
    const resize=new ResizeObserver(cover);resize.observe(viewport);cover();
    viewport.addEventListener('dragstart',e=>e.preventDefault());
    viewport.addEventListener('pointerdown',e=>{
      if(!e.isPrimary||e.button!==0)return;
      pointer=e.pointerId;lastX=startX=e.clientX;moved=false;
      viewport.classList.add('is-dragging');
    });
    viewport.addEventListener('pointermove',e=>{
      if(e.pointerId!==pointer)return;
      if(Math.abs(e.clientX-startX)>5)moved=true;
      if(moved){if(!viewport.hasPointerCapture(pointer))viewport.setPointerCapture(pointer);viewport.scrollLeft+=lastX-e.clientX;wrap();}
      lastX=e.clientX;
    });
    const release=e=>{
      if(e.pointerId!==pointer)return;
      if(viewport.hasPointerCapture(pointer))viewport.releasePointerCapture(pointer);
      pointer=null;resumeAt=performance.now()+3000;viewport.classList.remove('is-dragging');
    };
    viewport.addEventListener('pointerup',release);
    viewport.addEventListener('pointercancel',release);
    window.addEventListener('pointerup',release);
    viewport.addEventListener('click',e=>{if(moved){e.preventDefault();e.stopPropagation();moved=false;}},true);
    viewport.addEventListener('keydown',e=>{if(e.key==='ArrowLeft'||e.key==='ArrowRight'){e.preventDefault();viewport.scrollLeft+=e.key==='ArrowRight'?180:-180;wrap();resumeAt=performance.now()+3000;}});
    viewport.addEventListener('wheel',()=>resumeAt=performance.now()+3000,{passive:true});
    const tick=time=>{
      if(!root.isConnected){cancelAnimationFrame(frame);resize.disconnect();return;}
      const delta=Math.min(time-lastTime,50);lastTime=time;
      if(pointer===null&&!viewport.matches(':focus-visible')&&!document.hidden&&!reduced.matches&&time>resumeAt&&loopWidth>0){position+=delta*.035;if(position>=loopWidth*2)position-=loopWidth;viewport.scrollLeft=position;}
      frame=requestAnimationFrame(tick);
    };
    cover();
    frame=requestAnimationFrame(tick);
  };
  document.querySelectorAll('.mora-catalog-slider').forEach(setup);
  document.addEventListener('shopify:section:load',e=>e.target.querySelectorAll('.mora-catalog-slider').forEach(setup));
})();
