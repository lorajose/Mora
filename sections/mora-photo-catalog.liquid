{% stylesheet %}
.mora-photo-catalog{background:#fff;padding:40px 24px 80px}.mora-photo-catalog__grid{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:72px 36px;max-width:2000px;margin:0 auto}.mora-photo-catalog__item{display:block;aspect-ratio:1;background:#fff}.mora-photo-catalog__item img{display:block;width:100%;height:100%;object-fit:contain;mix-blend-mode:multiply}.mora-photo-catalog__item:focus-visible{outline:2px solid #111;outline-offset:5px}@media(max-width:1199px){.mora-photo-catalog__grid{grid-template-columns:repeat(4,minmax(0,1fr));gap:48px 24px}}@media(max-width:749px){.mora-photo-catalog{padding:24px 16px 56px}.mora-photo-catalog__grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:36px 16px}}

.mora-catalog-slider{margin-top:100px;position:relative;padding-top:40px}.mora-catalog-slider__viewport{overflow:hidden}.mora-catalog-slider__track{display:flex;width:max-content;animation:mora-catalog-left 55s linear infinite}.mora-catalog-slider__group{display:flex;align-items:center;gap:48px;padding-right:48px}.mora-catalog-slider__group .mora-photo-catalog__item{width:clamp(150px,18vw,320px);flex:none}.mora-catalog-slider__toggle{position:absolute;top:8px;right:155px;width:16px;height:16px;accent-color:#111}.mora-catalog-slider__pause{position:absolute;top:4px;right:0;font-size:12px;cursor:pointer}.mora-catalog-slider:hover .mora-catalog-slider__track,.mora-catalog-slider:focus-within .mora-catalog-slider__track,.mora-catalog-slider__toggle:checked~.mora-catalog-slider__viewport .mora-catalog-slider__track{animation-play-state:paused}@keyframes mora-catalog-left{to{transform:translateX(-50%)}}@media(prefers-reduced-motion:reduce){.mora-catalog-slider__track{animation:none}.mora-catalog-slider__viewport{overflow-x:auto}.mora-catalog-slider__group[aria-hidden]{display:none}.mora-catalog-slider__toggle,.mora-catalog-slider__pause{display:none}}@media(max-width:749px){.mora-catalog-slider{margin-top:64px}.mora-catalog-slider__group{gap:24px;padding-right:24px}}

{% endstylesheet %}
