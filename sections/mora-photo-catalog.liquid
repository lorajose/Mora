{% stylesheet %}
.mora-photo-catalog{background:#fff;padding:40px 24px 80px}.mora-photo-catalog__grid{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:72px 36px;max-width:2000px;margin:0 auto}.mora-photo-catalog__item{display:block;aspect-ratio:1;background:#fff}.mora-photo-catalog__item img{display:block;width:100%;height:100%;object-fit:contain;mix-blend-mode:multiply}.mora-photo-catalog__item:focus-visible{outline:2px solid #111;outline-offset:5px}@media(max-width:1199px){.mora-photo-catalog__grid{grid-template-columns:repeat(4,minmax(0,1fr));gap:48px 24px}}@media(max-width:749px){.mora-photo-catalog{padding:24px 16px 56px}.mora-photo-catalog__grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:36px 16px}}

.mora-catalog-slider{margin-top:100px}.mora-catalog-slider__viewport{overflow-x:auto;scrollbar-width:none;cursor:grab;touch-action:pan-y;user-select:none}.mora-catalog-slider__viewport::-webkit-scrollbar{display:none}.mora-catalog-slider__viewport.is-dragging{cursor:grabbing}.mora-catalog-slider__track{display:flex;width:max-content}.mora-catalog-slider__group{display:flex;align-items:center;gap:48px;padding-right:48px}.mora-catalog-slider__group .mora-photo-catalog__item{width:clamp(150px,18vw,320px);flex:none}.mora-catalog-slider img{-webkit-user-drag:none;pointer-events:none}.mora-catalog-slider__viewport:focus-visible{outline:2px solid #111;outline-offset:5px}@media(max-width:749px){.mora-catalog-slider{margin-top:64px}.mora-catalog-slider__group{gap:24px;padding-right:24px}}

{% endstylesheet %}
{% javascript %}

(() => {
  const setup = root => {
    if(root.dataset.dragReady) return;
    root.dataset.dragReady='true';
    const viewport=root.querySelector('.mora-catalog-slider__viewport');
    const group=root.querySelector('.mora-catalog-slider__group');
    const reduced=matchMedia('(prefers-reduced-motion: reduce)');
    let pointer=null,lastX=0,startX=0,moved=false,hover=false,focus=false,resumeAt=0,lastTime=0,frame;
    const wrap=()=>{const width=group.getBoundingClientRect().width;if(width>0){if(viewport.scrollLeft>=width)viewport.scrollLeft-=width;else if(viewport.scrollLeft<=0)viewport.scrollLeft+=width;}};
    viewport.addEventListener('pointerenter',e=>{if(e.pointerType==='mouse')hover=true;});
    viewport.addEventListener('pointerleave',()=>{hover=false;});
    viewport.addEventListener('focusin',()=>focus=true);
    viewport.addEventListener('focusout',()=>focus=false);
    viewport.addEventListener('dragstart',e=>e.preventDefault());
    viewport.addEventListener('pointerdown',e=>{
      if(!e.isPrimary||e.button!==0)return;
      pointer=e.pointerId;lastX=startX=e.clientX;moved=false;
      viewport.classList.add('is-dragging');
    });
    viewport.addEventListener('pointermove',e=>{
      if(e.pointerId!==pointer)return;
      if(Math.abs(e.clientX-startX)>5)moved=true;
      if(moved){if(!viewport.hasPointerCapture(pointer))viewport.setPointerCapture(pointer);viewport.scrollLeft+=lastX-e.clientX;wrap();}
      lastX=e.clientX;
    });
    const release=e=>{
      if(e.pointerId!==pointer)return;
      if(viewport.hasPointerCapture(pointer))viewport.releasePointerCapture(pointer);
      pointer=null;resumeAt=performance.now()+3000;viewport.classList.remove('is-dragging');
    };
    viewport.addEventListener('pointerup',release);
    viewport.addEventListener('pointercancel',release);
    window.addEventListener('pointerup',release);
    viewport.addEventListener('click',e=>{if(moved){e.preventDefault();e.stopPropagation();moved=false;}},true);
    viewport.addEventListener('keydown',e=>{if(e.key==='ArrowLeft'||e.key==='ArrowRight'){e.preventDefault();viewport.scrollLeft+=e.key==='ArrowRight'?180:-180;wrap();resumeAt=performance.now()+3000;}});
    viewport.addEventListener('wheel',()=>resumeAt=performance.now()+3000,{passive:true});
    const tick=time=>{
      if(!root.isConnected){cancelAnimationFrame(frame);return;}
      const delta=Math.min(time-lastTime,50);lastTime=time;
      if(pointer===null&&!hover&&!focus&&!document.hidden&&!reduced.matches&&time>resumeAt){viewport.scrollLeft+=delta*.035;wrap();}
      frame=requestAnimationFrame(tick);
    };
    viewport.scrollLeft=group.getBoundingClientRect().width;
    frame=requestAnimationFrame(tick);
  };
  document.querySelectorAll('.mora-catalog-slider').forEach(setup);
  document.addEventListener('shopify:section:load',e=>e.target.querySelectorAll('.mora-catalog-slider').forEach(setup));
})();
{% endjavascript %}
