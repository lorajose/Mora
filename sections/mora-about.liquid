<section class="mora-about page-width">
<p class="mora-about__eyebrow">COLLECTIVE BY MORA</p>
<img class="mora-about__symbol" src="{{ 'mora-symbol.png' | asset_url }}" width="2048" height="2048" alt="" loading="eager">
<h1>{{ 'mora_about.title' | t }}</h1>
<img class="mora-about__wordmark" src="{{ 'mora-wordmark.png' | asset_url }}" width="2048" height="192" alt="MORA" loading="eager">
<p class="mora-about__intro">{{ section.settings.headline | escape }}</p>
<div class="mora-about__story">{{ section.settings.story }}</div>
<a class="button" href="{{ routes.all_products_collection_url }}">{{ 'mora_about.catalog' | t }}</a>
<a class="mora-about__instagram link" href="https://www.instagram.com/bymora.ny/" target="_blank" rel="noopener noreferrer"><span class="svg-wrapper">{{ 'icon-instagram.svg' | inline_asset_content }}</span> @bymora.ny</a>
</section>
{% stylesheet %}
.mora-about{max-width:780px;text-align:center;padding-top:72px;padding-bottom:96px}.mora-about__eyebrow{font-size:11px;letter-spacing:.2em}.mora-about__symbol{display:block;width:150px;height:auto;margin:32px auto 0;filter:brightness(0)}.mora-about h1{font-size:18px;letter-spacing:.15em;margin:28px 0}.mora-about__wordmark{display:block;width:min(80%,360px);height:auto;margin:0 auto 36px;filter:brightness(0)}.mora-about p{line-height:1.8}.mora-about__intro{font-size:clamp(24px,4vw,34px);font-weight:700;line-height:1.3!important;margin:40px 0 28px}.mora-about__story{text-align:left;max-width:660px;margin:0 auto}.mora-about__story p{margin:0 0 24px}.mora-about__story p:nth-last-child(-n+2){text-align:center}.mora-about .button{margin-top:24px}.mora-about__instagram{display:flex;align-items:center;justify-content:center;gap:10px;margin-top:28px;color:inherit}.mora-about__instagram .svg-wrapper{width:22px;height:22px}
{% endstylesheet %}
{% schema %}
{"name":"MORA About","settings":[{"type":"text","id":"headline","label":"Headline","default":"More Than Clothing. It's a Way of Life."},{"type":"richtext","id":"story","label":"Brand story","default":"<p>Collective by MORA is an independent streetwear brand built on individuality, creativity, and the freedom to express yourself without limitations.</p><p>We believe fashion is more than what you wear. It's a reflection of who you are, where you've been, and where you're going. Every piece we create is designed with purpose, combining street culture, athletic influences, vintage inspiration, and everyday comfort.</p><p>At Collective by MORA, we don't believe in following trends. We believe in creating our own lane. From bold statement pieces to everyday essentials, our goal is to make clothing that speaks for itself while allowing the person wearing it to tell their own story.</p><p>The Collective represents a journey. Different backgrounds, different experiences, different destinations, but one shared mindset: <strong>stay true to yourself and never be afraid to stand apart.</strong></p><p>We're not just building a clothing brand. We're building a culture rooted in authenticity, ambition, and self-expression.</p><p><strong>This is Collective by MORA.</strong></p><p><em>Your Journey. Your Identity. Your Collective.</em></p>"}],"presets":[{"name":"MORA About"}]}
{% endschema %}
