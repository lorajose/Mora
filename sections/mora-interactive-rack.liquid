<div class="mora-rack__detail"><div class="mora-rack__image"><img data-rack-image width="1200" height="1400" alt=""></div><div class="mora-rack__info"><p>COLLECTIVE BY MORA</p><h3 id="RackTitle-{{ section.id }}" data-rack-title></h3><div class="mora-rack__angles" data-rack-angles></div><a href="{{ routes.all_products_collection_url }}" class="mora-rack__catalog">{{ section.settings.catalog_label | escape }} ↗</a><div class="mora-rack__navigation"><button type="button" data-rack-prev aria-label="Previous item">←</button><span data-rack-count></span><button type="button" data-rack-next aria-label="Next item">→</button></div></div></div>
</dialog>
</mora-interactive-rack>
{% stylesheet %}

.mora-rack{display:block;background:#f5f4ef;color:#171914;padding:64px max(20px,4vw) 30px;overflow:hidden}
.mora-rack__heading{text-align:center}.mora-rack__heading p{font-size:11px;letter-spacing:.12em}.mora-rack__heading h2{font-size:clamp(30px,4vw,58px);letter-spacing:-.04em;margin:12px 0 22px;color:inherit}
.mora-rack__rail{position:relative;margin:65px auto 25px;overflow-x:auto;overflow-y:hidden;padding:10px 0 15px;scrollbar-width:thin}
.mora-rack__rail:before{content:'';position:absolute;top:22px;left:0;width:max(100%,1250px);height:6px;border-radius:6px;background:linear-gradient(#e7ebe6,#8e9690,#d6dcd5,#717b72);box-shadow:0 4px 5px #0002}
.mora-rack__pieces{display:flex;align-items:flex-start;justify-content:center;min-width:1250px;min-height:370px;padding:0 65px;perspective:1500px}
.mora-rack__piece{position:relative;flex:1 1 0;min-width:0;height:340px;border:0;background:transparent;color:inherit;cursor:pointer;transition:flex .55s ease;isolation:auto}
.mora-rack__garment{position:absolute;top:0;left:50%;width:230px;height:305px;margin-left:-115px;transform:rotateY(58deg);transform-origin:50% 12px;transition:transform .6s cubic-bezier(.2,.8,.2,1);filter:drop-shadow(3px 9px 4px #0002)}
.mora-rack__hanger{position:absolute;top:0;left:30%;width:40%;height:auto;z-index:0}
.mora-rack__piece img{position:absolute;top:12px;left:0;width:100%;height:280px;object-fit:contain;object-position:center top;z-index:1;pointer-events:none}
.mora-rack__piece--pants img{top:32px;height:285px}.mora-rack__piece--pants .mora-rack__hanger{width:50%;left:25%}
.mora-rack__piece span{position:absolute;top:316px;left:50%;translate:-50% 0;width:200px;font-size:10px;letter-spacing:.04em;opacity:0;transition:opacity .3s}
.mora-rack__piece:focus-visible{outline:2px solid #55624a;outline-offset:3px}
.mora-rack__piece.is-selected,.mora-rack__piece:focus-visible{flex:2.3;z-index:4}
.mora-rack__piece.is-selected .mora-rack__garment,.mora-rack__piece:focus-visible .mora-rack__garment{transform:rotateY(0)}
.mora-rack__piece.is-selected span,.mora-rack__piece:focus-visible span{opacity:1}
@media(hover:hover){.mora-rack__piece:hover{flex:2.3;z-index:4}.mora-rack__piece:hover .mora-rack__garment{transform:rotateY(0)}.mora-rack__piece:hover span{opacity:1}}
.mora-rack__footer{display:flex;justify-content:space-between;border-top:1px solid #0002;padding-top:22px;font-size:11px;letter-spacing:.12em}.mora-rack a{color:inherit;text-decoration:none}
.mora-rack__dialog{border:0;background:#f5f4ef;color:#171914;padding:48px;width:min(1100px,94vw);max-height:92svh;overflow:auto}.mora-rack__dialog::backdrop{background:#141810aa;backdrop-filter:blur(9px)}.mora-rack__close{position:absolute;top:14px;right:18px;border:0;background:transparent;color:inherit;font-size:24px;padding:8px;cursor:pointer}.mora-rack__detail{display:grid;grid-template-columns:1.4fr 1fr;gap:40px;align-items:center}.mora-rack__image img{display:block;width:100%;height:60svh;object-fit:contain;mix-blend-mode:normal;animation:mora-rack-reveal .4s ease}.mora-rack__info h3{font-size:clamp(26px,4vw,42px);line-height:1.15;color:inherit}.mora-rack__angles{display:flex;gap:10px;margin:30px 0}.mora-rack__angles button{padding:10px 18px;border:1px solid #94998a;background:transparent;color:inherit;cursor:pointer;font:inherit;font-size:12px}.mora-rack__angles button[aria-pressed=true]{background:#222d21;color:#fff}.mora-rack__catalog{display:inline-block;border-bottom:1px solid;padding-bottom:8px;font-size:12px;letter-spacing:.1em}.mora-rack__navigation{display:flex;align-items:center;gap:25px;margin-top:44px;font-size:12px}.mora-rack__navigation button{border:1px solid #a6aa9c;border-radius:50%;width:44px;height:44px;background:transparent;font-size:20px;cursor:pointer;color:inherit}
.mora-rack__dialog{background:transparent;color:white;box-shadow:none}.mora-rack__dialog::backdrop{background:#0c110dd4;backdrop-filter:blur(12px)}.mora-rack__dialog h3,.mora-rack__dialog a,.mora-rack__close{color:white}.mora-rack__angles button,.mora-rack__navigation button{color:white;border-color:#fff8}.mora-rack__angles button[aria-pressed=true]{background:white;color:#172016}
@media(max-width:749px){.mora-rack{padding:45px 16px 24px}.mora-rack__pieces{justify-content:flex-start;min-width:1450px;padding:0 70px}.mora-rack__rail:before{width:1450px}.mora-rack__dialog{padding:45px 20px 25px}.mora-rack__detail{grid-template-columns:1fr;gap:10px}.mora-rack__image img{height:42svh}.mora-rack__info{text-align:center}.mora-rack__angles,.mora-rack__navigation{justify-content:center}}
@media(prefers-reduced-motion:reduce){.mora-rack *{transition:none!important;animation:none!important}}

{% endstylesheet %}
{% javascript %}
if(!customElements.get('mora-interactive-rack')){
class MoraInteractiveRack extends HTMLElement{
connectedCallback(){
if(this.ready)return;this.ready=true;
this.items=JSON.parse(this.querySelector('[data-rack-items]').textContent);
this.dialog=this.querySelector('dialog');this.index=0;this.angle=0;
this.addEventListener('click',e=>{
const piece=e.target.closest('[data-piece]');
if(piece){
if(matchMedia('(hover: none)').matches&&!piece.classList.contains('is-selected')){
this.querySelectorAll('[data-piece]').forEach(p=>p.classList.toggle('is-selected',p===piece));return;
}
this.trigger=piece;this.index=Number(piece.dataset.piece);this.angle=this.items[this.index].initialAngle||0;this.render();this.dialog.showModal();}
if(e.target.closest('[data-rack-close]'))this.dialog.close();
if(e.target.closest('[data-rack-prev]'))this.step(-1);
if(e.target.closest('[data-rack-next]'))this.step(1);
const angle=e.target.closest('[data-angle]');if(angle){this.angle=Number(angle.dataset.angle);this.render();}
});
this.dialog.addEventListener('close',()=>this.trigger?.focus());
this.dialog.addEventListener('click',e=>{if(e.target===this.dialog){const b=this.dialog.getBoundingClientRect();if(e.clientX<b.left||e.clientX>b.right||e.clientY<b.top||e.clientY>b.bottom)this.dialog.close();}});
this.dialog.addEventListener('keydown',e=>{if(e.key==='ArrowLeft'){e.preventDefault();this.step(-1);}if(e.key==='ArrowRight'){e.preventDefault();this.step(1);}});
let x=null;const image=this.querySelector('.mora-rack__image');
image.addEventListener('pointerdown',e=>x=e.clientX);
image.addEventListener('pointerup',e=>{if(x!==null&&Math.abs(e.clientX-x)>55)this.step(e.clientX<x?1:-1);x=null;});
image.addEventListener('pointercancel',()=>x=null);
}
step(direction){this.index=(this.index+direction+this.items.length)%this.items.length;this.angle=this.items[this.index].initialAngle||0;this.render();}
render(){
const item=this.items[this.index],im=item.images[this.angle];
this.querySelector('[data-rack-title]').textContent=item.title;
const image=this.querySelector('[data-rack-image]');image.src=im.src;image.alt=im.alt;
this.querySelector('[data-rack-count]').textContent=String(this.index+1).padStart(2,'0')+' / '+String(this.items.length).padStart(2,'0');
const buttons=item.images.map((im,i)=>{const b=document.createElement('button');b.type='button';b.dataset.angle=i;b.textContent=i===0?'Front':'Back';b.setAttribute('aria-pressed',String(this.angle===i));return b;});
this.querySelector('[data-rack-angles]').replaceChildren(...buttons);
}
}
customElements.define('mora-interactive-rack',MoraInteractiveRack);
}
{% endjavascript %}
{% schema %}
{"name":"MORA interactive wardrobe","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"THE MORA WARDROBE"},{"type":"text","id":"heading","label":"Heading","default":"Find your next statement."},{"type":"text","id":"hint","label":"Interaction hint","default":"Explore a piece. Make it yours."},{"type":"text","id":"catalog_label","label":"Catalog link label","default":"EXPLORE THE CATALOG"}],"presets":[{"name":"MORA interactive wardrobe"}]}
{% endschema %}
