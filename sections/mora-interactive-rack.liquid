{% stylesheet %}
.mora-rack{display:block;background:#f5f4ef;color:#171914;padding:80px max(24px,5vw) 32px;overflow:hidden}.mora-rack__heading{text-align:center}.mora-rack__heading p,.mora-rack__footer,.mora-rack__info>p{font-size:11px;letter-spacing:.17em}.mora-rack__heading h2{font-size:clamp(32px,5vw,64px);letter-spacing:-.045em;margin:12px 0 20px;color:inherit}.mora-rack__heading p:last-child{letter-spacing:.04em;color:#686b60}.mora-rack__rail{position:relative;margin:76px auto 44px;max-width:1500px}.mora-rack__rail:before{content:'';position:absolute;top:13px;left:0;right:0;height:3px;background:linear-gradient(90deg,#b6b6ac,#efeee7,#777e6c,#d8d8cc);box-shadow:0 5px 12px #0002}.mora-rack__pieces{display:flex;align-items:flex-start;justify-content:center;min-height:330px;padding:0 12px 50px}.mora-rack__piece{position:relative;flex:1;min-width:0;max-width:250px;padding:0;border:0;background:transparent;color:inherit;cursor:pointer;transition:flex .45s ease,transform .45s ease,opacity .45s ease;transform-origin:top center}.mora-rack__hanger{display:block;width:65%;height:55px;margin:0 auto -6px;color:#686d60}.mora-rack__piece img{display:block;width:100%;height:clamp(200px,23vw,350px);object-fit:contain;mix-blend-mode:normal;filter:drop-shadow(0 14px 8px #0001);transition:transform .45s ease}.mora-rack__piece span{display:block;font-size:10px;letter-spacing:.09em;text-transform:uppercase;margin-top:24px;opacity:.6}.mora-rack__piece:focus-visible{outline:2px solid #55624a;outline-offset:5px}.mora-rack__footer{display:flex;justify-content:space-between;align-items:center;border-top:1px solid #1a241c26;padding-top:22px}.mora-rack a{color:inherit;text-decoration:none}.mora-rack a:hover{text-decoration:underline;text-underline-offset:5px}@media(hover:hover){.mora-rack__pieces:has(.mora-rack__piece:hover) .mora-rack__piece:not(:hover){opacity:.48}.mora-rack__piece:hover{flex:1.65;transform:translateY(-8px);z-index:2}.mora-rack__piece:hover img{transform:rotate(-3deg) scale(1.08)}.mora-rack__piece:hover span{opacity:1}}
.mora-rack__dialog{border:0;background:#f5f4ef;color:#171914;padding:48px;width:min(1100px,94vw);max-height:92svh;overflow:auto}.mora-rack__dialog::backdrop{background:#141810aa;backdrop-filter:blur(9px)}.mora-rack__close{position:absolute;top:14px;right:18px;border:0;background:transparent;color:inherit;font-size:24px;padding:8px;cursor:pointer}.mora-rack__detail{display:grid;grid-template-columns:1.4fr 1fr;gap:40px;align-items:center}.mora-rack__image img{display:block;width:100%;height:60svh;object-fit:contain;mix-blend-mode:normal;animation:mora-rack-reveal .4s ease}.mora-rack__info h3{font-size:clamp(26px,4vw,42px);line-height:1.15;color:inherit}.mora-rack__angles{display:flex;gap:10px;margin:30px 0}.mora-rack__angles button{padding:10px 18px;border:1px solid #94998a;background:transparent;color:inherit;cursor:pointer;font:inherit;font-size:12px}.mora-rack__angles button[aria-pressed=true]{background:#222d21;color:#fff}.mora-rack__catalog{display:inline-block;border-bottom:1px solid;padding-bottom:8px;font-size:12px;letter-spacing:.1em}.mora-rack__navigation{display:flex;align-items:center;gap:25px;margin-top:44px;font-size:12px}.mora-rack__navigation button{border:1px solid #a6aa9c;border-radius:50%;width:44px;height:44px;background:transparent;font-size:20px;cursor:pointer;color:inherit}@keyframes mora-rack-reveal{from{opacity:.3;transform:translateY(10px)}to{opacity:1;transform:none}}@media(max-width:749px){.mora-rack{padding:56px 18px 24px}.mora-rack__rail{margin-top:48px;overflow-x:auto;padding-top:8px}.mora-rack__rail:before{width:1050px;top:21px}.mora-rack__pieces{width:max-content;justify-content:flex-start;gap:10px;min-height:310px}.mora-rack__piece{flex:none;width:165px}.mora-rack__piece img{height:230px}.mora-rack__dialog{padding:45px 22px 28px}.mora-rack__detail{grid-template-columns:1fr;gap:8px}.mora-rack__image img{height:42svh}.mora-rack__info{text-align:center}.mora-rack__angles,.mora-rack__navigation{justify-content:center}.mora-rack__info h3{margin:12px 0}.mora-rack__angles{margin:18px 0}.mora-rack__navigation{margin-top:25px}}@media(prefers-reduced-motion:reduce){.mora-rack *{animation:none!important;transition:none!important}}

.mora-rack__rail{perspective:1400px;padding-top:3px}
.mora-rack__rail:before{top:12px;height:8px;border-radius:9px;background:linear-gradient(#e4e7e5 0%,#fff 20%,#8c9391 48%,#bac0bc 65%,#606964 100%);box-shadow:0 3px 3px #0003,0 18px 22px #0001}
.mora-rack__pieces{min-height:440px;gap:0;padding:0 30px 60px;perspective:1400px}
.mora-rack__piece{flex:1;max-width:230px;isolation:auto;transition:flex .65s cubic-bezier(.2,.8,.2,1);transform:none!important}
.mora-rack__garment{position:relative;transform:rotateY(67deg) rotateZ(-2deg);transform-origin:50% 16px;transform-style:preserve-3d;transition:transform .7s cubic-bezier(.2,.8,.2,1),filter .7s;filter:drop-shadow(9px 14px 7px #0002);mix-blend-mode:normal}
.mora-rack__hanger{position:relative;width:73%;height:80px;margin:-3px auto -33px;z-index:0;filter:drop-shadow(0 2px 1px #0002)}
.mora-rack__piece img{position:relative;height:clamp(260px,28vw,400px);filter:drop-shadow(2px 6px 2px #0002);transform:none!important}
.mora-rack__piece span{opacity:0;transition:opacity .3s;min-height:30px}
.mora-rack__piece:nth-child(even) .mora-rack__garment{transform:rotateY(67deg) rotateZ(1.5deg)}
.mora-rack__pieces:has(.mora-rack__piece:hover) .mora-rack__piece:not(:hover){opacity:1}
.mora-rack__piece.is-selected,.mora-rack__piece:focus-visible{flex:1.9;z-index:3}
.mora-rack__piece.is-selected .mora-rack__garment,.mora-rack__piece:focus-visible .mora-rack__garment{transform:rotateY(0) rotateZ(0);filter:drop-shadow(0 22px 12px #0002)}
.mora-rack__piece.is-selected span,.mora-rack__piece:focus-visible span{opacity:1}
@media(hover:hover){.mora-rack__piece:hover{flex:1.9;z-index:3}.mora-rack__piece:hover .mora-rack__garment{transform:rotateY(0) rotateZ(0);filter:drop-shadow(0 22px 12px #0002)}.mora-rack__piece:hover span{opacity:1}}
@media(max-width:749px){.mora-rack__rail:before{top:20px;width:1150px}.mora-rack__pieces{min-height:365px;width:1150px;padding-left:16px;padding-right:16px;gap:0}.mora-rack__piece{width:175px;flex:1}.mora-rack__piece img{height:280px}.mora-rack__hanger{height:70px;margin-bottom:-29px}.mora-rack__piece.is-selected{flex:1.7}.mora-rack__garment{transform:rotateY(64deg) rotateZ(-2deg)}}

.mora-rack__garment{filter:drop-shadow(5px 12px 6px #0002)}.mora-rack__piece img{filter:drop-shadow(1px 4px 2px #0002)}.mora-rack__image img{filter:drop-shadow(0 14px 12px #0002)}
{% endstylesheet %}
{% javascript %}
if(!customElements.get('mora-interactive-rack')){
class MoraInteractiveRack extends HTMLElement{
connectedCallback(){
if(this.ready)return;this.ready=true;
this.items=JSON.parse(this.querySelector('[data-rack-items]').textContent);
this.dialog=this.querySelector('dialog');this.index=0;this.angle=0;
this.addEventListener('click',e=>{
const piece=e.target.closest('[data-piece]');
if(piece){
if(matchMedia('(hover: none)').matches&&!piece.classList.contains('is-selected')){
this.querySelectorAll('[data-piece]').forEach(p=>p.classList.toggle('is-selected',p===piece));return;
}
this.trigger=piece;this.index=Number(piece.dataset.piece);this.angle=0;this.render();this.dialog.showModal();}
if(e.target.closest('[data-rack-close]'))this.dialog.close();
if(e.target.closest('[data-rack-prev]'))this.step(-1);
if(e.target.closest('[data-rack-next]'))this.step(1);
const angle=e.target.closest('[data-angle]');if(angle){this.angle=Number(angle.dataset.angle);this.render();}
});
this.dialog.addEventListener('close',()=>this.trigger?.focus());
this.dialog.addEventListener('click',e=>{if(e.target===this.dialog){const b=this.dialog.getBoundingClientRect();if(e.clientX<b.left||e.clientX>b.right||e.clientY<b.top||e.clientY>b.bottom)this.dialog.close();}});
this.dialog.addEventListener('keydown',e=>{if(e.key==='ArrowLeft'){e.preventDefault();this.step(-1);}if(e.key==='ArrowRight'){e.preventDefault();this.step(1);}});
let x=null;const image=this.querySelector('.mora-rack__image');
image.addEventListener('pointerdown',e=>x=e.clientX);
image.addEventListener('pointerup',e=>{if(x!==null&&Math.abs(e.clientX-x)>55)this.step(e.clientX<x?1:-1);x=null;});
image.addEventListener('pointercancel',()=>x=null);
}
step(direction){this.index=(this.index+direction+this.items.length)%this.items.length;this.angle=0;this.render();}
render(){
const item=this.items[this.index],im=item.images[this.angle];
this.querySelector('[data-rack-title]').textContent=item.title;
const image=this.querySelector('[data-rack-image]');image.src=im.src;image.alt=im.alt;
this.querySelector('[data-rack-count]').textContent=String(this.index+1).padStart(2,'0')+' / '+String(this.items.length).padStart(2,'0');
const buttons=item.images.map((im,i)=>{const b=document.createElement('button');b.type='button';b.dataset.angle=i;b.textContent=i===0?'Front':'Back';b.setAttribute('aria-pressed',String(this.angle===i));return b;});
this.querySelector('[data-rack-angles]').replaceChildren(...buttons);
}
}
